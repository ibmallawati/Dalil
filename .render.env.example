# Copy this file to '.render.env' (already gitignored — never commit the real
# one) and fill in your own values. deploy.ps1 reads it to (a) confirm the new
# deploy actually goes live on Render and (b) run the post-deploy smoke test.
#
# Neither value is required to deploy — deploy.ps1 still works with just
# `git push` if this file is absent — but without it the script can't tell
# you whether the deploy succeeded or where to smoke-test it.
#
# Get an API key: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From the Render dashboard URL for this service:
# https://dashboard.render.com/web/srv-d9abdncs728c73eg8qeg -> srv-d9abdncs728c73eg8qeg
RENDER_SERVICE_ID=srv-d9abdncs728c73eg8qeg
