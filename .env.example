# Copy this file to '.env' (already gitignored - never commit the real one)
# and fill in your own values.

# Required. Get one at https://huggingface.co/settings/tokens - it must have
# the "Make calls to Inference Providers" permission.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Any chat model available in the HuggingFace Inference Playground
# (https://huggingface.co/playground). Defaults to Qwen/Qwen2.5-7B-Instruct.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Optional. Comma-separated SQLite files the text-to-SQL path can query.
# Defaults to data/databases/omantel_demo.db.
DB_PATHS=data/databases/plans.db,data/databases/billing.db,data/databases/omantel_demo.db

# Optional. Port Flask listens on when run locally (Render/Cloud Run inject
# their own PORT at deploy time). Defaults to 7860.
PORT=7860

# Optional. Python logging level for the JSON stdout logs. Defaults to INFO;
# set to DEBUG to see per-chunk retrieval similarity scores.
LOG_LEVEL=INFO
