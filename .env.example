# Copy this file to '.env' (already gitignored - never commit the real one)
# and fill in your own values.
#
# COST CONSTRAINT: this project runs at $0. Every default below points at a
# free service. Do not point LLM_BASE_URL at a paid endpoint.

# =========================================================================
# GENERATION - remote, OpenAI-COMPATIBLE, provider-neutral
# =========================================================================
# Deliberately named LLM_* rather than after any one vendor: swapping
# Gemini -> Ollama (or anything else speaking the OpenAI chat API) is a
# change to these three lines, never a code change.

# Required. For Gemini: https://aistudio.google.com/apikey
#
# $0 WARNING: create the key in a project with NO BILLING ACCOUNT attached.
# A key from a billing-enabled project silently bills at paid-tier rates
# instead of rejecting the request when you exceed the free quota.
#
# For a local Ollama server this value is ignored, but must still be set -
# use any placeholder, e.g. "ollama".
LLM_API_KEY=

# Optional. OpenAI-compatible base URL.
#   Gemini free tier : https://generativelanguage.googleapis.com/v1beta/openai/
#   Local Ollama     : http://localhost:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional. Chat model used for routing, clarifying questions (D4), and
# answer generation (D5).
#
# Free-tier note: as of 2026 only Flash and Flash-Lite tiers are free -
# Pro models were removed from the free tier. Confirm what YOUR project is
# actually entitled to at https://aistudio.google.com/rate-limit before a
# demo; entitlements are per-project and change without notice.
#
# MEASURED 31 Jul 2026 against a real free-tier key:
#   gemini-3.6-flash       WORKS. ~3s, correct Arabic. Recommended.
#   gemini-3.5-flash-lite  WORKS. No reasoning tokens by default.
#   gemini-3.1-flash-lite  WORKS.
#   gemini-3.5-flash       20 REQUESTS PER DAY on the free tier. Unusable
#                          for development, and one bad rehearsal exhausts
#                          it for the rest of the day. Do not use.
#   llama3.1 / qwen2.5     typical Ollama local model names
#
# This is an ORDERED FAILOVER CHAIN, comma-separated. When a model's daily
# quota is exhausted the app moves to the next one automatically and logs
# which model served the answer - nobody should be editing .env in front of
# a panel.
#
# Daily quotas reset at MIDNIGHT PACIFIC = 11:00 Muscat time.
LLM_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional. Gemini 3.x Flash are THINKING models and their reasoning tokens
# count against max_tokens. Measured: 305 reasoning tokens to answer "what
# is the capital of Oman", and at max_tokens=100 the model returned the
# string 'Information Retrieval' - an internal thought fragment served as
# the answer. "minimal" measured 0 reasoning tokens with an identical reply.
#
# Set EMPTY for providers that reject the parameter (Ollama will 400 on it).
# It is only sent when non-empty, and a 400 naming it disables it
# automatically for the rest of the process.
LLM_REASONING_EFFORT=minimal

# Optional. Sized from the WORST case, measured 31 Jul 2026:
#   short service (6 short sections)            198 completion tokens
#   long service (15 documents, 12 steps)       832 completion tokens
#   at max_tokens=500 -> truncated, JSON DOES NOT PARSE
# Card length is driven by LIST fields, not prose - a long repetitive
# service gets summarised, a long checklist does not. 2000 is ~2.4x the
# measured worst case; the headroom is free because the free tier limits
# requests per day, not tokens.
LLM_MAX_TOKENS=2000

# =========================================================================
# EMBEDDINGS - remote by default, same endpoint and key as generation
# =========================================================================
# gemini (default): questions are embedded over HTTPS through LLM_BASE_URL
#   with LLM_API_KEY - no second credential. gemini-embedding-001 is
#   natively 3072-wide; it is requested at EMBED_DIM and re-normalised in
#   chatbot.rag.retrieval. Nothing is downloaded at startup.
#
# local: intfloat/multilingual-e5-base, in-process via sentence-transformers
#   (not in requirements.txt; ~1.2 GB of RAM). A comparison baseline only.
#   Selecting it also defaults EMBED_MODEL and EMBED_DIM to e5's values.
#
# The committed data/index/embeddings.npy was built with gemini-embedding-001
# at 768. CHANGING ANY OF THESE INVALIDATES IT - re-run
# scripts/build_index.py AND re-derive SIMILARITY_THRESHOLD (D2), because
# similarity scores are not comparable across embedding models. e5 is also
# 768-wide, so the startup dimension check will not catch a stale index.
EMBED_BACKEND=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Optional. Minimum cosine similarity a chunk must reach to be used as
# grounding. Below this, Dalil refuses instead of guessing.
#
# MEASURED for gemini-embedding-001 at 768 dims (23 Aug 2026): the worst
# legitimate question scored 0.6382, the best unrelated one 0.5908. At 0.61
# no real question was refused and no unrelated one answered. See the D2
# comment in src/chatbot/config.py. Re-derive it if the embedding model
# changes - the old e5 value (0.80) refuses half the questions under Gemini.
SIMILARITY_THRESHOLD=0.61

# Optional. If the best chunk of one service and the best chunk of a
# DIFFERENT service score within this margin, Daleel asks which one the
# citizen means instead of silently taking the top hit.
#
# PROVISIONAL - D2 derives this alongside the threshold.
AMBIGUITY_MARGIN=0.02

# =========================================================================
# RUNTIME
# =========================================================================

# Optional. Comma-separated SQLite files the text-to-SQL path can query.
# Legacy from the Chatbot-Public fork (Phase 4). Daleel has no database;
# the code is retained in the repo but is not part of Daleel's scope.
DB_PATHS=data/databases/plans.db,data/databases/billing.db,data/databases/omantel_demo.db

# Optional. Where the prebuilt index lives. Defaults to data/index.
# Set to data/fixtures/index to develop against the invented fixture corpus
# before the real one lands. Numbers measured against fixtures are NOT
# results and must never be quoted.
#   INDEX_DIR=data/fixtures/index

# Optional. Port Flask listens on when run locally. Defaults to 7860.
PORT=7860

# Optional. Python logging level for the JSON stdout logs. Defaults to INFO;
# set to DEBUG to see per-chunk retrieval similarity scores.
LOG_LEVEL=INFO
